{
  "name": "baseline_pure_unet_v1",
  "seed": 42,
  "device": "auto",
  "dataset": {
    "root": "data/Kvasir-SEG",
    "manifest": "data/splits/kvasir_seg_seed42_70_15_15.json",
    "image_size": [224, 224],
    "mask_threshold": 128,
    "prediction_threshold": 0.5
  },
  "model": {
    "in_channels": 3,
    "out_channels": 1,
    "features": [32, 64, 128, 256, 256],
    "negative_slope": 0.01,
    "instance_norm_eps": 1e-5
  },
  "loss": {
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "dice_epsilon": 1e-6
  },
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "CosineAnnealingLR",
    "t_max": 100,
    "eta_min": 1e-6
  },
  "training": {
    "epochs": 100,
    "batch_size": 4,
    "num_workers": 0,
    "pin_memory": false,
    "checkpoint_dir": "experiments/runs/baseline_pure_unet_seed42"
  },
  "sanity": {
    "max_batches": 2,
    "checkpoint_path": "experiments/sanity/baseline_pure_unet_seed42.pt"
  }
}
